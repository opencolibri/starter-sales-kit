<div {{ attributes }}>
    <twig:shadcn:Card>
        <twig:shadcn:Card:Header>
            <twig:shadcn:Card:Title>{{ 'opencolibri_sales_kit.ui.storefront_theme'|trans }}</twig:shadcn:Card:Title>
            <twig:shadcn:Card:Description>{{ 'opencolibri_sales_kit.ui.storefront_theme_description'|trans }}</twig:shadcn:Card:Description>
        </twig:shadcn:Card:Header>
        <twig:shadcn:Card:Content class="flex flex-col gap-3">
            {{ component('sales_kit:message', {message: error}) }}
            {% if applied %}
                {{ component('sales_kit:message', {message: 'opencolibri_sales_kit.ui.theme_applied'|trans({'%theme%': currentTheme}), type: 'success'}) }}
            {% endif %}
            <div class="flex flex-wrap items-center gap-2">
                <label class="sr-only" for="theme">{{ 'opencolibri_sales_kit.ui.theme'|trans }}</label>
                <twig:shadcn:NativeSelect id="theme" data-model="theme">
                    {% for item in themes %}
                        <option value="{{ item }}"{% if item == theme %} selected{% endif %}>{{ item }}{% if item == currentTheme %} ({{ 'opencolibri_sales_kit.ui.current'|trans }}){% endif %}</option>
                    {% endfor %}
                </twig:shadcn:NativeSelect>
                {{ component('sales_kit:action_button', {action: 'apply', label: 'opencolibri_sales_kit.ui.apply_theme'|trans, variant: 'outline', size: 'default', icon: 'lucide:paintbrush'}) }}
            </div>
        </twig:shadcn:Card:Content>
    </twig:shadcn:Card>
</div>
