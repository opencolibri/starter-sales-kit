{
    "name": "opencolibri/starter-sales-kit",
    "description": "Castor tasks of the sales kit: demo shops on their own subdomain, private shops, shop admins and themes",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/opencolibri/colibri-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lfremont@jolicode.com"
        },
        {
            "name": "Jérôme Gangneux",
            "email": "jerome@gangneux.net"
        }
    ],
    "require": {
        "php": ">=8.3",
        "opencolibri/starter-core": "self.version",
        "opencolibri/starter-fixtures": "self.version",
        "symfony/dotenv": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "suggest": {
        "jolicode/castor-api": "Expose the tasks over HTTP"
    },
    "autoload": {
        "psr-4": {
            "OpenColibri\\Starter\\SalesKit\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenColibri\\Starter\\SalesKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
